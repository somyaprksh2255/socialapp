# Squado backend environment — names and placeholders only.
# Copy to .env locally (ignored by Git) or configure these variables in your API host.
# Never commit a real server secret or place it in frontend source.

PORT=8787
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_CLIENT_ID=
SUPABASE_JWKS_URL=
# Set exactly one server-only key in your private deployment environment, never here:
SUPABASE_SECRET_KEY=
# Alternative name accepted by the server:
# SUPABASE_SERVICE_ROLE_KEY=

# Exact comma-separated frontend origins; no paths and no wildcard.
CORS_ALLOWLIST=http://127.0.0.1:3000,http://localhost:3000,https://somyaprksh2255.github.io
MAX_IMAGE_MB=10
